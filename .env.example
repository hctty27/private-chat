# App
TZ=Asia/Shanghai
# Application/database timezone used by Go and PostgreSQL DSN.
TIME_ZONE=Asia/Shanghai
LISTEN_ADDR=:8080
# GIN_MODE supports debug, release, test
GIN_MODE=release
# Comma-separated IP/CIDR list. Empty means do not trust proxy headers.
TRUSTED_PROXIES=
# Optional comma-separated cross-origin WebSocket allowlist. Same-origin is always allowed.
WS_ALLOWED_ORIGINS=
# Keep true behind HTTPS. Set false only for local plain-HTTP development.
AUTH_COOKIE_SECURE=true
JWT_SECRET=<replace_with_at_least_32_random_characters>
# Idle session lifetime. Active sessions renew back up to this duration.
JWT_EXPIRATION=1h
# Hard upper bound for one login, regardless of activity.
JWT_ABSOLUTE_EXPIRATION=720h

# PostgreSQL / Neon
POSTGRES_HOST=ep-plain-wildflower-akk5xcgx.c-3.us-west-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=private_chat
POSTGRES_SSLMODE=require

# Login location (optional)
# Server-side only. Requires Amap Web Service API key with Advanced IP Location enabled.
# Empty disables login-time city refresh.
AMAP_WEB_SERVICE_KEY=

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=<redis_password>

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=<r2_access_key_id>
R2_SECRET_KEY=<r2_secret_access_key>
R2_BUCKET=us-r2
R2_OBJECT_PREFIX=private-chat

# WebRTC voice calls
# Cloudflare Realtime TURN is the recommended/default provider.
WEBRTC_ENABLED=false
WEBRTC_ICE_POLICY=all
WEBRTC_TURN_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=<cloudflare_turn_key_uid>
CLOUDFLARE_TURN_API_TOKEN=<cloudflare_turn_key_bearer_token>
WEBRTC_TURN_CREDENTIAL_TTL=10m

# Optional self-hosted Coturn fallback. Set WEBRTC_TURN_PROVIDER=coturn to use these.
WEBRTC_STUN_URL=stun:turn.example.com:3478
WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
WEBRTC_TURN_SECRET=<replace_with_long_random_turn_shared_secret>
WEBRTC_TURN_REALM=turn.example.com
WEBRTC_TURN_EXTERNAL_IP=<public_ipv4>
WEBRTC_TURN_MIN_PORT=49160
WEBRTC_TURN_MAX_PORT=49200
