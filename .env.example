# App
TZ=Asia/Shanghai
LISTEN_ADDR=:8080
# GIN_MODE supports debug, release, test
GIN_MODE=release
# Comma-separated IP/CIDR list. Empty means do not trust proxy headers.
TRUSTED_PROXIES=
# Optional comma-separated cross-origin WebSocket allowlist. Same-origin is always allowed.
WS_ALLOWED_ORIGINS=
# Keep true behind HTTPS. Set false only for local plain-HTTP development.
AUTH_COOKIE_SECURE=true
JWT_SECRET=<replace_with_at_least_32_random_characters>
JWT_EXPIRATION=24h

# PostgreSQL / Neon
POSTGRES_HOST=ep-plain-wildflower-akk5xcgx.c-3.us-west-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=private_chat
POSTGRES_SSLMODE=require

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=<redis_password>

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=<r2_access_key_id>
R2_SECRET_KEY=<r2_secret_access_key>
R2_BUCKET=us-r2
R2_OBJECT_PREFIX=private-chat
